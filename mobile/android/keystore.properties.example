# Local release signing for the Android app.
#
# Copy to keystore.properties in this directory and fill in real values.
# keystore.properties is gitignored (root .gitignore) and must never be
# committed or uploaded to CI — production releases are signed locally with an
# offline app-signing key (see docs/ANDROID-RELEASE.md).
#
# Absent this file, debug builds work as usual and local release builds fail
# closed rather than falling back to the Android debug key.

# Absolute path to the offline keystore file (keep outside the repository).
storeFile=/home/YOUR_USER/Keys/rustok-app-signing.keystore

# Alias of the key inside the keystore.
keyAlias=rustok

# Password for both the keystore and the key.
password=YOUR_STRONG_PASSWORD
