# Release signing for the Android app.
#
# Copy to keystore.properties in this directory and fill in real values.
# keystore.properties is gitignored (root .gitignore) and must never be
# committed — it points at the upload key for Google Play.
#
# The Android Release workflow writes this file itself from the repository
# secrets ANDROID_KEYSTORE_BASE64 / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD,
# so it is only needed for local release builds.
#
# Absent this file, debug builds work as usual and release builds fail with a
# clear message rather than falling back to the debug key.

# Absolute path to the keystore file. Keep it outside the repository.
storeFile=/home/YOUR_USER/Keys/rustok-release.keystore

# Alias of the key inside the keystore.
keyAlias=rustok

# Password for both the keystore and the key.
password=YOUR_STRONG_PASSWORD
